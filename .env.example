# Copy this file to `.env` and fill in your keys. `.env` is git-ignored.
# Keys are read only by the Electron main process; they are never sent to a window.
ANTHROPIC_API_KEY=
DEEPGRAM_API_KEY=

# Only if Claude answers "API key is not scoped to a workspace": the workspace to use.
# ANTHROPIC_WORKSPACE_ID=

# --- Optional tuning (defaults shown; remove the leading # to change) ---------
# Claude model for replies. claude-haiku-5-5 is the lowest-latency current model.
# ECHO_CLAUDE_MODEL=claude-haiku-5-5
# Model for deep-dive lessons ("explain it deeply", the > button): slower to start, much deeper.
# ECHO_DEEP_MODEL=claude-sonnet-5-5
# Quality-first route: turns that need it go to this model instead of the fast one. It starts later (ECHO only says a
# brief wait line if nothing has been heard after 1.5 s). Simple conversation stays on ECHO_CLAUDE_MODEL.
# ECHO_STRONG_MODEL=claude-sonnet-5-5
# Which turns take the quality route ("all", "none", or a comma list):
#   reasoning  debugging, comparisons, maths, proofs, design, explanations of how things work, "I still don't get it"
#   screen     questions about the shared screen (code, errors, diagrams, equations)
#   lesson     answers taught on the whiteboard
#   practice   checking the learner's answers in a quiz or practice
#   follow-up  short follow-ups ("what about that?") right after a quality-route answer
# ECHO_QUALITY_ROUTES=all
# Whether the quality model thinks before answering (adaptive or off), and how hard it and the deep model work
# (low, medium, high, xhigh, max). Benchmark with tests/live/models.live.test.ts before changing models or effort.
# ECHO_STRONG_THINKING=adaptive
# ECHO_STRONG_EFFORT=high
# ECHO_DEEP_EFFORT=high
# Set ECHO_SMART_ROUTING=false to answer everything but deep dives on ECHO_CLAUDE_MODEL.
# ECHO_SMART_ROUTING=true
# ECHO_CLAUDE_MAX_TOKENS=1200
# Turn thinking off for faster first words (falls back automatically if the model rejects it).
# ECHO_CLAUDE_DISABLE_THINKING=true
# ECHO_HISTORY_MESSAGES=24

# Deepgram Flux turn detection. flux-general-en is English; flux-general-multi is multilingual.
# ECHO_STT_MODEL=flux-general-en
# Higher = waits longer through pauses before answering (0.5 to 1.0).
# ECHO_EOT_THRESHOLD=0.8
# Silence after which a turn is ended regardless of confidence (500 to 60000 ms).
# ECHO_EOT_TIMEOUT_MS=4000
# Setting this enables Flux's EagerEndOfTurn events (0.3 to 0.9). Off by default.
# ECHO_EAGER_EOT_THRESHOLD=
# Words heard with less confidence than this are passed to Claude as "possibly misheard", so it checks ("Did you mean
# cache?") instead of answering the wrong question. 0 turns it off.
# ECHO_STT_UNSURE_CONFIDENCE=0.6

# Deepgram Aura-2 voice, e.g. aura-2-thalia-en, aura-2-helena-en, aura-2-apollo-en, aura-2-aries-en.
# ECHO_TTS_VOICE=aura-2-thalia-en
# Speech is voiced in pieces, and each piece gets its own intonation. The first piece waits for this many characters
# (lower = first word sooner, but choppier), later pieces group sentences up to this size (higher = more natural
# flow; Deepgram allows about 20 pieces a minute).
# ECHO_TTS_FIRST_CHARS=40
# ECHO_TTS_GROUP_CHARS=220

# Log per-reply latency metrics to the console (no keys are ever logged).
# ECHO_LOG_METRICS=true

# --- Web search ---------------------------------------------------------------
# ECHO can search the web (Anthropic's server-side web search tool) for facts it shouldn't answer from memory.
# It must be enabled for your Anthropic organization; if it isn't, ECHO notices and answers without it.
# ECHO_WEB_SEARCH=true
# Most searches in a quick answer, and in a deep dive (which researches before it teaches).
# ECHO_WEB_SEARCH_MAX_USES=2
# ECHO_WEB_SEARCH_DEEP_MAX_USES=5
# Reading whole pages (Anthropic's web fetch tool): after searching, ECHO can open the most relevant results and answer
# from the page itself rather than the short search snippet. It only opens pages from its results or links you gave.
# ECHO_WEB_FETCH=true
# ECHO_WEB_FETCH_MAX_USES=1
# ECHO_WEB_FETCH_DEEP_MAX_USES=3
# Most of a page (in tokens) read at once; longer pages are cut. Lower = faster and cheaper.
# ECHO_WEB_FETCH_MAX_TOKENS=8000
# Anthropic-hosted code execution (runs on Anthropic's servers, never on this computer) for checking calculations and
# code examples. Quick answers only: deep dives use the newer web search, which the docs say not to combine with it.
# ECHO_CODE_EXECUTION=true

# --- Visual lessons -----------------------------------------------------------
# While the lesson window is open ECHO draws on the whiteboard as it explains. The same tutor model writes
# the drawing and the narration in one reply (no second agent), so there is nothing else to configure.
# ECHO_VISUALS=true
# Real pictures on the whiteboard (a pig, the Eiffel Tower, a heart diagram), found on Wikimedia Commons and shown with
# their author and license. Only the search words are sent to Wikimedia.
# ECHO_PICTURES=true
