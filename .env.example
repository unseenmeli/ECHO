# Copy this file to `.env` and fill in your keys. `.env` is git-ignored.
# Keys are read only by the Electron main process; they are never sent to a window.
ANTHROPIC_API_KEY=
DEEPGRAM_API_KEY=

# Only if Claude answers "API key is not scoped to a workspace": the workspace to use.
# ANTHROPIC_WORKSPACE_ID=

# --- Optional tuning (defaults shown; remove the leading # to change) ---------
# Claude model for replies. claude-haiku-5-5 is the lowest-latency current model.
# ECHO_CLAUDE_MODEL=claude-haiku-5-5
# Model for deep-dive lessons ("explain it deeply", the > button): slower to start, much deeper.
# ECHO_DEEP_MODEL=claude-sonnet-5-5
# ECHO_CLAUDE_MAX_TOKENS=400
# Turn thinking off for faster first words (falls back automatically if the model rejects it).
# ECHO_CLAUDE_DISABLE_THINKING=true
# ECHO_HISTORY_MESSAGES=24

# Deepgram Flux turn detection. flux-general-en is English; flux-general-multi is multilingual.
# ECHO_STT_MODEL=flux-general-en
# Higher = waits longer through pauses before answering (0.5 to 1.0).
# ECHO_EOT_THRESHOLD=0.8
# Silence after which a turn is ended regardless of confidence (500 to 60000 ms).
# ECHO_EOT_TIMEOUT_MS=4000
# Setting this enables Flux's EagerEndOfTurn events (0.3 to 0.9). Off by default.
# ECHO_EAGER_EOT_THRESHOLD=

# Deepgram Aura-2 voice, e.g. aura-2-thalia-en, aura-2-helena-en, aura-2-apollo-en, aura-2-aries-en.
# ECHO_TTS_VOICE=aura-2-thalia-en

# Log per-reply latency metrics to the console (no keys are ever logged).
# ECHO_LOG_METRICS=true

# --- Visual lessons -----------------------------------------------------------
# While the lesson window is open ECHO draws on the whiteboard as it explains. The same tutor model writes
# the drawing and the narration in one reply (no second agent), so there is nothing else to configure.
# ECHO_VISUALS=true
