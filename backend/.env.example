# Server-side secrets for the ECHO backend. On Vercel, set these under Project → Settings → Environment Variables.
# For `vercel dev`, `vercel env pull .env.local` copies them down. Never put them in the Electron app.
ANTHROPIC_API_KEY=
DEEPGRAM_API_KEY=
# ANTHROPIC_WORKSPACE_ID=

# Judge access codes: label:code pairs, comma-separated. Generate with `npm run codes -- 5`.
ECHO_ACCESS_CODES=

# Usage store (Upstash Redis from the Vercel Marketplace sets these for you; either naming works).
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
# Production refuses to run without Redis. Set to 1 to allow per-instance memory counters instead (weak limits).
# ECHO_ALLOW_MEMORY_LIMITS=

# --- Limits (defaults shown) ---------------------------------------------------------------------------------------
# Per access code, per UTC day:
# ECHO_LIMIT_REQUESTS_PER_DAY=600
# ECHO_LIMIT_INPUT_TOKENS_PER_DAY=4000000
# ECHO_LIMIT_OUTPUT_TOKENS_PER_DAY=300000
# ECHO_LIMIT_DEEPGRAM_TOKENS_PER_DAY=200
# Per access code, per minute:
# ECHO_LIMIT_REQUESTS_PER_MINUTE=30
# All codes together, per UTC day:
# ECHO_GLOBAL_REQUESTS_PER_DAY=5000

# --- What the Anthropic proxy accepts --------------------------------------------------------------------------------
# ECHO_ALLOWED_MODELS=claude-haiku-5-5,claude-sonnet-5-5,claude-opus-5-5
# ECHO_MAX_OUTPUT_TOKENS=24000
# ECHO_MAX_SERVER_TOOL_USES=10
# Lifetime of a Deepgram token, in seconds (30 to 3600). Only needed long enough to open a socket.
# ECHO_DEEPGRAM_TOKEN_TTL=60
